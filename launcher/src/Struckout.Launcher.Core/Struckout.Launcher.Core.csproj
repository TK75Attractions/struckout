<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- LibraryImport in Platform/ProcessJob.cs -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ports are defined once in api/spec/servers.yaml and shared by every module. -->
    <EmbeddedResource Include="../../../api/spec/servers.yaml" LogicalName="servers.yaml" />
    <EmbeddedResource Include="../../../game_master/docker/config.dev.toml" LogicalName="game-master-config.toml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.HealthCheck" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Struckout.Launcher.Core.Tests" />
  </ItemGroup>
</Project>

import { TwoColorOutlinedButton } from "../components/button.slint";

global Adopter {
    in property <bool> busy;
    in property <string> error-msg;
    callback move-to-start-screen();
}

export component GameFinishedScreen {
    // How long the screen waits before returning home by itself.
    // Meanwhile the projector shows the ranking (the score in simple mode).
    // Without it, an unattended machine would keep showing them instead of getting ready for the next player.
    private property <duration> auto-return-interval: 20s;

    // The screen exists only while it is shown, so leaving it stops the timer.
    // The timer pauses while a request is in flight and restarts after a failure, so it also retries.
    Timer {
        interval: root.auto-return-interval;
        running: !Adopter.busy;
        triggered => {
            Adopter.move-to-start-screen();
        }
    }

    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 32px;
        padding: 32px;
        Text {
            text: "ゲームが終了しました";
            font-size: 32px;
        }

        TwoColorOutlinedButton {
            text: "ホーム画面に戻る";
            font-size: 28px;
            enabled: !Adopter.busy;
            clicked => { Adopter.move-to-start-screen(); }
        }

        Text {
            text: Adopter.error-msg;
            wrap: word-wrap;
        }
    }
}

export { Adopter as GameFinishedAdopter }

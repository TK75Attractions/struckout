import { TwoColorOutlinedButton } from "../components/button.slint";

global Adopter {
    in property <bool> busy;
    in property <string> error-msg;
    callback move-to-start-screen();
}

export component GameFinishedScreen {
    private property <length> comp_button_font_size: 2rem;
    private property <length> comp_button_padding_lr: 96px;
    private property <length> comp_button_padding_tb: 48px;

    VerticalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 32px;
        padding: 32px;
        Text {
            text: "ゲームが終了しました";
            font-size: 32px;
        }

        TwoColorOutlinedButton {
            text: "ホーム画面に戻る";
            font-size: root.comp_button_font_size;
            layout-lr: root.comp_button_padding_lr;
            layout-tb: root.comp_button_padding_tb;
            enabled: !Adopter.busy;
            clicked => { Adopter.move-to-start-screen(); }
        }

        Text {
            text: Adopter.error-msg;
            wrap: word-wrap;
        }
    }
}

export { Adopter as GameFinishedAdopter }

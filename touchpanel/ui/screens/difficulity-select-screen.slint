import { Button } from "std-widgets.slint";
import {
    SquareButton,
    TwoColorOutlinedButton,
    CornerButton,
    Corner,
} from "../components/button.slint";
import {
    Fonts,
    Outline,
    StruckoutPalette,
    FontSettings,
} from "../styling.slint";

enum Difficulity { Normal, Hard, VeryHard }

global Adopter {
    in property <Difficulity> selected-difficulity;
    in property <bool> busy;
    in property <bool> ready;
    in property <string> error-msg;

    callback select-difficulity(val: Difficulity);
    callback start-game();
}

export component DifficulitySelectScreen inherits Rectangle {
    private property <length> comp_button_font_size: 24px;
    private property <length> comp_difficulty_font_size: 2rem;
    private property <length> comp_buttons_padding: 48px;
    private property <length> comp_buttons_spacing: 48px;
    private property <percent> comp_buttons_height_ratio: 60%;

    pure function difficulty-text(difficulty: Difficulity) -> string {
        if difficulty == Difficulity.Normal {
            return "的が緩やかに動く";
        } else if difficulty == Difficulity.Hard {
            return "的が激しめに動く";
        } else if difficulty == Difficulity.VeryHard {
            return "的が激しく動く";
        }
        return "UNKNOWN DIFFICULTY";
    }

    VerticalLayout {
        alignment: LayoutAlignment.space-between;
        padding-top: 16px;

        // Side by side, the buttons can share the screen's width instead of each getting a third of its height.
        // The buttons ignore their text's width so that they get the same width.
        HorizontalLayout {
            height: 75%;
            cross-axis-alignment: CrossAxisAlignment.center;
            padding-left: root.comp_buttons_padding;
            padding-right: root.comp_buttons_padding;
            spacing: root.comp_buttons_spacing;

            TwoColorOutlinedButton {
                min-width: 0px;
                preferred-width: 0px;
                height: root.comp_buttons_height_ratio;
                horizontal-stretch: 1;
                font-family: Fonts.oxanium;
                font-size: root.comp_difficulty_font_size;
                enabled: !Adopter.busy && !Adopter.ready;
                text: "NORMAL";
                emphasize: Adopter.selected-difficulity == Difficulity.Normal;
                clicked => {
                    Adopter.select-difficulity(Difficulity.Normal);
                }
            }

            TwoColorOutlinedButton {
                min-width: 0px;
                preferred-width: 0px;
                height: root.comp_buttons_height_ratio;
                horizontal-stretch: 1;
                font-family: Fonts.oxanium;
                font-size: root.comp_difficulty_font_size;
                enabled: !Adopter.busy && !Adopter.ready;
                text: "HARD";
                emphasize: Adopter.selected-difficulity == Difficulity.Hard;
                clicked => {
                    Adopter.select-difficulity(Difficulity.Hard);
                }
            }

            TwoColorOutlinedButton {
                min-width: 0px;
                preferred-width: 0px;
                height: root.comp_buttons_height_ratio;
                horizontal-stretch: 1;
                font-family: Fonts.oxanium;
                font-size: root.comp_difficulty_font_size;
                enabled: !Adopter.busy && !Adopter.ready;
                text: "VERY HARD";
                emphasize: Adopter.selected-difficulity == Difficulity.VeryHard;
                clicked => {
                    Adopter.select-difficulity(Difficulity.VeryHard);
                }
            }
        }

        Rectangle {
            height: 25%;

            VerticalLayout {
                width: 40%;
                padding-bottom: 16px;
                padding-top: 16px;

                Rectangle {
                    border-width: Outline.level1;
                    border-color: StruckoutPalette.ref_primary_60;

                    Text {
                        text: Adopter.error-msg != "" ? Adopter.error-msg : Adopter.ready ? "もう1人の準備完了を待っています" : difficulty-text(Adopter.selected-difficulity);
                        wrap: word-wrap;
                        color: StruckoutPalette.ref_primary_90;
                        font-size: FontSettings.body-large.font-size;
                        font-weight: FontSettings.body-large.font-weight;
                        font-family: Fonts.note-sans-jp;
                    }
                }
            }

            CornerButton {
                x: parent.width - self.width;
                y: parent.height - self.height;
                height: 100%;
                width: self.preferred-width * 1.5;
                enabled: !Adopter.busy && !Adopter.ready;
                text: Adopter.ready ? "待機中" : "START";
                font-family: Fonts.oxanium;
                font-size: root.comp_button_font_size;
                corner: Corner.RightBottom;
                filled: true;
                clicked => {
                    Adopter.start-game();
                }
            }
        }
    }
}

export { Adopter as DifficulitySelectAdopter }

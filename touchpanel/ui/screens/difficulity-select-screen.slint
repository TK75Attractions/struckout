import { Button } from "std-widgets.slint";
import {
    SquareButton,
    TwoColorOutlinedButton,
    CornerButton,
    Corner,
} from "../components/button.slint";
import { Fonts } from "../styling.slint";

enum Difficulity { Normal, Hard, VeryHard }

global Adopter {
    in property <Difficulity> selected-difficulity;

    callback select-difficulity(val: Difficulity);
    callback start-game();
}

export component DifficulitySelectScreen inherits Rectangle {
    private property <length> comp_button_font_size: 24px;
    private property <length> comp_margin_lr: 40px;
    private property <length> comp_margin_tb: 10px;

    VerticalLayout {
        alignment: LayoutAlignment.stretch;
        padding-top: 16px;

        VerticalLayout {
            cont1 := Rectangle {
                TwoColorOutlinedButton {
                    font-family: Fonts.oxanium;
                    font-size: root.comp_button_font_size;
                    layout-lr: root.comp_margin_lr;
                    layout-tb: root.comp_margin_tb;
                    text: "NORMAL";
                    width: max(cont1.preferred-width, cont2.preferred-width, cont3.preferred-width);
                    emphasize: Adopter.selected-difficulity == Difficulity.Normal;
                    clicked => {
                        Adopter.select-difficulity(Difficulity.Normal);
                    }
                }
            }

            cont2 := Rectangle {
                TwoColorOutlinedButton {
                    font-family: Fonts.oxanium;
                    font-size: root.comp_button_font_size;
                    layout-lr: root.comp_margin_lr;
                    layout-tb: root.comp_margin_tb;
                    text: "HARD";
                    width: max(cont1.preferred-width, cont2.preferred-width, cont3.preferred-width);
                    emphasize: Adopter.selected-difficulity == Difficulity.Hard;
                    clicked => {
                        Adopter.select-difficulity(Difficulity.Hard);
                    }
                }
            }

            cont3 := Rectangle {
                TwoColorOutlinedButton {
                    font-family: Fonts.oxanium;
                    font-size: root.comp_button_font_size;
                    layout-lr: root.comp_margin_lr;
                    layout-tb: root.comp_margin_tb;
                    text: "VERY HARD";
                    width: max(cont1.preferred-width, cont2.preferred-width, cont3.preferred-width);
                    emphasize: Adopter.selected-difficulity == Difficulity.VeryHard;
                    clicked => {
                        Adopter.select-difficulity(Difficulity.VeryHard);
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: LayoutAlignment.end;

            CornerButton {
                text: "Start";
                corner: Corner.RightBottom;
                filled: true;
                clicked => {
                    Adopter.start-game();
                }
            }
        }
    }
}

export { Adopter as DifficulitySelectAdopter }

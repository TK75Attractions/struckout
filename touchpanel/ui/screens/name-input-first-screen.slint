import { Icons } from "../icons.slint";
import {
    Keyboard,
    KeyBoardMode,
} from "../components/keyboard.slint";
import { StruckoutPalette } from "../styling.slint";
import { TextEdit, LineEdit } from "std-widgets.slint";

global Adopter {
    in property <string> player-name-text;
    in property <KeyBoardMode> keyboard-mode;
    in property <string> error-msg;
    callback set-keyboard-mode(mode: KeyBoardMode);
    callback push-character(char: string);
    callback remove-character();
    callback submit-name();
    callback modify();
}

export component NameInputFirstScreen inherits Rectangle {
    private property <brush> comp_outline: StruckoutPalette.ref_grey_30;

    VerticalLayout {
        alignment: LayoutAlignment.stretch;

        // TODO: LineEditで違和感がないかを実機で試す
        Rectangle {
            // border-color: comp_outline;
            // border-width: 4px;

            text-box := Text {
                text: Adopter.player-name-text;
            }
        }

        if Adopter.error-msg != "": Rectangle {
            Text {
                text: Adopter.error-msg;
                color: red;
                wrap: TextWrap.char-wrap;
            }
        }

        Keyboard {
            mode: Adopter.keyboard-mode;
            height: 50%;

            set-keyboard-mode(mode) => {
                Adopter.set-keyboard-mode(mode);
            }
            backspace() => {
                Adopter.remove-character();
            }
            submit() => {
                Adopter.submit-name();
            }
            modify() => {
                Adopter.modify();
            }
            char-added(char) => {
                Adopter.push-character(char);
            }
        }
    }
}

export { Adopter as NameInputFirstAdopter }

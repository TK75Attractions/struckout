import { CornerButton, Corner } from "../components/button.slint";
import { Button } from "std-widgets.slint";
import { Fonts } from "../styling.slint";

enum Rank {
    S,
    A,
    B,
    C,
}

global Adopter {
    in property <Rank> rank;
    in property <int> score;

    callback next-clicked();
}

component RankIcon {
    in property <Rank> rank;

    Text {
        text: "S";
    }
}

export component ScoreScreen inherits Rectangle {
    private property <length> comp_button_font_size: 24px;

    VerticalLayout {
        cross-axis-alignment: CrossAxisAlignment.end;

        HorizontalLayout {
            alignment: LayoutAlignment.center;
            cross-axis-alignment: CrossAxisAlignment.center;
            width: 100%;

            /*RankIcon {
                rank: Adopter.rank;
            }*/

            Text {
                text: Adopter.score;
                font-family: Fonts.oxanium;
                font-size: 72pt;
            }
        }

        CornerButton {
            width: 30%;
            height: 24%;
            corner: Corner.RightBottom;
            filled: true;
            font-size: root.comp_button_font_size;
            text: "次へ";
        }
    }
}



export { Adopter as ScoreAdopter }

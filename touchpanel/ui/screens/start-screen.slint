import { TwoColorOutlinedButton } from "../components/button.slint";

global Adopter {
    callback click-first-play();
    callback click-non-first-play();
}

export component StartScreen {
    private property <float> comp_btn_expand_ratio: 1;
    private property <length> comp_btn_font_size: 48px;

    VerticalLayout {
        alignment: LayoutAlignment.center;
        cross-axis-alignment: CrossAxisAlignment.center;
        padding: 32px;
        spacing: 16px;

        Image {
            source: @image-url("../assets/logos/struckout_logo_blue_yellow.jpg");
        }

        btn1 := TwoColorOutlinedButton {
            text: "プレイ(初回)";
            font-size: comp_btn_font_size;
            width: max(btn1.preferred-width * comp_btn_expand_ratio, btn2.preferred-width * comp_btn_expand_ratio);
            height: self.preferred-height * comp_btn_expand_ratio;
            clicked => {
                Adopter.click-first-play();
            }
        }

        btn2 := TwoColorOutlinedButton {
            text: "プレイ(2回目以降)";
            font-size: comp_btn_font_size;
            width: max(btn1.preferred-width * comp_btn_expand_ratio, btn2.preferred-width * comp_btn_expand_ratio);
            height: self.preferred-height * comp_btn_expand_ratio;
            clicked => {
                Adopter.click-non-first-play();
            }
        }
    }
}

export { Adopter as StartAdopter }

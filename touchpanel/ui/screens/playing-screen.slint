import {
    FontSettings,
    Fonts,
    Outline,
    StruckoutPalette,
} from "../styling.slint";
global Adopter {
    in property <string> score;
    in property <string> remaining-time;
}

export component PlayingScreen inherits Rectangle {
    VerticalLayout {
        width: 100%;
        cross-axis-alignment: CrossAxisAlignment.center;
        padding-top: 40px;
        padding-bottom: 40px;
        spacing: 80px;

        Rectangle {
            border-width: Outline.level1;
            border-color: StruckoutPalette.ref_secondary_50;
            width: 32%;

            Text {
                text: Adopter.remaining-time;
                font-family: Fonts.oxanium;
                font-size: 40pt;
                font-weight: FontSettings.body-large.font-weight;
            }
        }

        Rectangle {
            border-width: Outline.level2;
            border-color: StruckoutPalette.ref_primary_50;
            width: 50%;

            Text {
                text: Adopter.score;
                color: StruckoutPalette.ref_grey_100;
                font-family: Fonts.oxanium;
                font-size: 72pt;
                font-weight: FontSettings.body-large.font-weight;
            }
        }
    }
}

export { Adopter as PlayingAdopter }

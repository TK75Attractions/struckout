import {
    KeyBoardMode,
    Keyboard,
} from "../components/keyboard.slint";

global Adopter {
    in property <string> player-name-text;
    in property <KeyBoardMode> keyboard-mode;
    in property <string> error-msg;
    callback set-keyboard-mode(mode: KeyBoardMode);
    callback push-character(char: string);
    callback remove-character();
    callback submit-name();
    callback modify();
}

export component NameInputNonFirstScreen inherits Rectangle {
    VerticalLayout {
        alignment: LayoutAlignment.stretch;

        Rectangle {
            // border-color: black;
            // border-width: 4px;

            Text {
                text: Adopter.player-name-text;
            }
        }

        if Adopter.error-msg != "": Rectangle {
            Text {
                text: Adopter.error-msg;
                color: red;
                wrap: TextWrap.char-wrap;
            }
        }

        Keyboard {
            mode: Adopter.keyboard-mode;
            height: 50%;

            set-keyboard-mode(mode) => {
                Adopter.set-keyboard-mode(mode);
            }
            backspace() => {
                Adopter.remove-character();
            }
            submit() => {
                Adopter.submit-name();
            }
            modify() => {
                Adopter.modify();
            }
            char-added(char) => {
                Adopter.push-character(char);
            }
        }
    }
}

export { Adopter as NameInputNonFirstAdopter }

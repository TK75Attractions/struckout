component LeftBar {
    in property <KeyBoardMode> current-mode;
    in property <length> font-size;
    callback set-keyboard-mode(mode: KeyBoardMode);
    max-width: 28px;

    VerticalLayout {
        SquareButton {
            text: "あ";
            font-size: root.font-size;
            clicked => {
                root.set-keyboard-mode(KeyBoardMode.Hiragana);
            }
        }

        SquareButton {
            text: "ア";
            font-size: root.font-size;
            clicked => {
                root.set-keyboard-mode(KeyBoardMode.Katakana);
            }
        }

        SquareButton {
            text: "a";
            font-size: root.font-size;
            clicked => {
                root.set-keyboard-mode(KeyBoardMode.AlphabetLower);
            }
        }

        SquareButton {
            text: "A";
            font-size: root.font-size;
            clicked => {
                root.set-keyboard-mode(KeyBoardMode.AlphabetUpper);
            }
        }

        SquareButton {
            text: "123";
            font-size: root.font-size;
            clicked => {
                root.set-keyboard-mode(KeyBoardMode.Number);
            }
        }
    }
}

component RightBar {
    in property <length> font-size;
    callback backspace();
    callback submit();
    callback modify();

    GridLayout {

        SquareButton {
            icon: Icons.backspace;
            row: 0;
            font-size: root.font-size;
            clicked => {
                root.backspace();
            }
        }

        SquareButton {
            // U+FF9E, U+FF9F
            text: "小字ﾞﾟ";
            row: 1;
            font-size: root.font-size;
            clicked => {
                root.modify();
            }
        }

        SquareButton {
            text: "OK";
            filled: true;
            row: 2;
            rowspan: 3;
            font-size: root.font-size;
            clicked => {
                root.submit();
            }
        }
    }
}

export component Keyboard inherits Rectangle {
    in property <KeyBoardMode> mode;
    callback set-keyboard-mode(mode: KeyBoardMode);
    callback char-added(char: string);
    callback backspace();
    callback submit();
    callback modify();

    property <length> comp_font_size: 1rem;

    HorizontalLayout {
        LeftBar {
            font-size: root.comp_font-size;
            set-keyboard-mode(mode) => {
                root.set-keyboard-mode(mode);
            }
        }

        if mode == KeyBoardMode.Hiragana: HiraganaKeyboard {
            font-size: root.comp_font-size;
            char-added(char) => {
                root.char-added(char);
            }
        }
        if mode == KeyBoardMode.Katakana: KatakanaKeyboard {
            font-size: root.comp_font-size;
            char-added(char) => {
                root.char-added(char);
            }
        }
        if mode == KeyBoardMode.AlphabetUpper: AlphabetUpperKeyboard {
            font-size: root.comp_font-size;
            char-added(char) => {
                root.char-added(char);
            }
        }
        if mode == KeyBoardMode.AlphabetLower: AlphabetLowerKeyboard {
            font-size: root.comp_font-size * 1.2;
            char-added(char) => {
                root.char-added(char);
            }
        }
        if mode == KeyBoardMode.Number: NumberKeyboard {
            font-size: root.comp_font-size;
            char-added(char) => {
                root.char-added(char);
            }
        }

        RightBar {
            font-size: root.comp_font-size;
            backspace => {
                root.backspace();
            }
            submit => {
                root.submit();
            }
            modify => {
                root.modify();
            }
        }
    }
}

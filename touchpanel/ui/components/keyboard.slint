import { Icons } from "../icons.slint";
import { Button } from "std-widgets.slint";
import { StruckoutPalette, Outline } from "../styling.slint";
import { SquareButton } from "button.slint";

export enum KeyBoardMode {
    Hiragana,
    Katakana,
    AlphabetUpper,
    AlphabetLower,
    Number,
}

component KeyButton {
    in property <string> text;
    in property <length> font-size;
    private property <brush> comp_outline: StruckoutPalette.ref_grey_50;
    callback clicked();

    Rectangle {
        border-color: comp_outline;
        border-width: Outline.level1;

        Text {
            text: text;
            font-size: root.font-size;
        }

        touch := TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
}

component AlphabetUpperKeyboard inherits Rectangle {
    in property <length> font-size;
    callback char-added(char: string);

    GridLayout {
        for c[i] in ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"]: KeyButton {
            text: c;
            row: 0;
            col: i;
            font-size: root.font-size;
            clicked => {
                root.char-added(c);
            }
        }

        for c[i] in ["K", "L", "M", "N", "O", "P", "Q", "R", "S", "T"]: KeyButton {
            text: c;
            row: 1;
            col: i;
            font-size: root.font-size;
            clicked => {
                root.char-added(c);
            }
        }

        for c[i] in ["U", "V", "W", "X", "Y", "Z"]: KeyButton {
            text: c;
            row: 2;
            col: i;
            font-size: root.font-size;
            clicked => {
                root.char-added(c);
            }
        }

        for c[i] in ["", "", "", ""]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 2;
            col: i + 6;
        }

        for c[i] in ["", "", "", "", "", "", "", "", "", ""]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 3;
            col: i;
        }

        for c[i] in ["", "", "", "", "", "", "", "", "", ""]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 4;
            col: i;
        }
    }
}


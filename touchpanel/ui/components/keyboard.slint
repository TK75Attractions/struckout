component NumberKeyboard inherits Rectangle {
    in property <length> font-size;
    callback char-added(char: string);

    GridLayout {
        for c[i] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 0;
            col: i;
            clicked => {
                root.char-added(c);
            }
        }
        for c[i] in ["", "", "", "", "", "", "", "", "", ""]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 1;
            col: i;
        }
        for c[i] in ["", "", "", "", "", "", "", "", "", ""]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 2;
            col: i;
        }
        for c[i] in ["", "", "", "", "", "", "", "", "", ""]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 3;
            col: i;
        }
        for c[i] in ["", "", "", "", "", "", "", "", "", ""]: KeyButton {
            text: c;
            font-size: root.font-size;
            row: 4;
            col: i;
        }
    }
}


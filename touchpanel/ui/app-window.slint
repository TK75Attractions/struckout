import "./assets/fonts/Oxanium-VariableFont_wght.ttf";

import { VerticalBox } from "std-widgets.slint";
import { TopBar } from "top-bar.slint";
import { StartScreen } from "./screens/start-screen.slint";
import {
    NameInputFirstScreen,
} from "./screens/name-input-first-screen.slint";
import {
    DifficulitySelectScreen,
} from "./screens/difficulity-select-screen.slint";
import { PlayingScreen } from "./screens/playing-screen.slint";
import { GameFinishedScreen } from "./screens/game-finished-screen.slint";
import { FallbackScreen } from "./screens/fallback-screen.slint";
import {
    ConnectionFailedScreen,
} from "./screens/connection-failed-screen.slint";
import { ConnectingScreen } from "./screens/connecting-screen.slint";
import {
    NameInputNonFirstScreen,
} from "./screens/name-input-non-first-screen.slint";
import {
    ModeSelectScreen,
    ModeSelectAdopter,
} from "./screens/mode-select-screen.slint";
//@xtask-import

export {
    StartAdopter,
} from "./screens/start-screen.slint";
export {
    NameInputFirstAdopter,
} from "./screens/name-input-first-screen.slint";
export {
    DifficulitySelectAdopter,
} from "./screens/difficulity-select-screen.slint";
export { FallbackAdopter } from "./screens/fallback-screen.slint";
export {
    ConnectionFailedAdopter,
} from "./screens/connection-failed-screen.slint";
export { PlayingAdopter } from "./screens/playing-screen.slint";
export { GameFinishedAdopter } from "./screens/game-finished-screen.slint";
export { ConnectingAdopter } from "./screens/connecting-screen.slint";
export {
    NameInputNonFirstAdopter,
} from "./screens/name-input-non-first-screen.slint";
export { ModeSelectAdopter } from "./screens/mode-select-screen.slint";
//@xtask-export

enum UiNavRoute {
    Start,
    NameInputFirst,
    DifficulitySelect,
    Playing,
    GameFinished,
    Fallback,
    ConnectionFailed,
    Connecting,
    NameInputNonFirst,
    ModeSelect,
    //@xtask-enum
}

export component AppWindow inherits Window {
    full-screen: true;
    default-font-family: "Oxanium,Noto Sans JP";
    default-font-size: 24px;

    in property <UiNavRoute> nav-route;
    in property <bool> mode-selection-enabled: true;
    callback click-backbutton();

    pure function items(route: UiNavRoute) -> [string] {
        if route == UiNavRoute.Start {
            return [];
        } else if route == UiNavRoute.NameInputFirst || route == UiNavRoute.NameInputNonFirst || route == UiNavRoute.DifficulitySelect {
            if root.mode-selection-enabled {
                return ["PLAYER NAME", "MODE", "DIFFICULTY"];
            }
            return ["PLAYER NAME", "DIFFICULTY"];
        } else if route == UiNavRoute.ModeSelect {
            return ["PLAYER NAME", "MODE", "DIFFICULTY"];
        } else if route == UiNavRoute.Playing {
            return [];
        } else if route == UiNavRoute.GameFinished {
            return [];
        } else if route == UiNavRoute.Fallback {
            return [];
        } else if route == UiNavRoute.ConnectionFailed {
            return [];
        } else if route == UiNavRoute.Connecting {
            return [];
        }
        return ["UNKNOWN ROUTE"];
    }

    pure function current-item-idx(route: UiNavRoute) -> int {
        if route == UiNavRoute.Start {
            return 0;
        } else if route == UiNavRoute.NameInputFirst {
            return 0;
        } else if route == UiNavRoute.NameInputNonFirst {
            return 0;
        } else if route == UiNavRoute.ModeSelect {
            return 1;
        } else if route == UiNavRoute.DifficulitySelect {
            return root.mode-selection-enabled ? 2 : 1;
        } else if route == UiNavRoute.Playing {
            return 0;
        } else if route == UiNavRoute.GameFinished {
            return 0;
        } else if route == UiNavRoute.Fallback {
            return 0;
        } else if route == UiNavRoute.ConnectionFailed {
            return 0;
        } else if route == UiNavRoute.Connecting {
            return 0;
        }
        return 0;
    }

    pure function show-topbar(route: UiNavRoute) -> bool {
        if route == UiNavRoute.Start {
            return false;
        } else if route == UiNavRoute.NameInputFirst {
            return true;
        } else if route == UiNavRoute.NameInputNonFirst {
            return true;
        } else if route == UiNavRoute.DifficulitySelect || route == UiNavRoute.ModeSelect {
            return true;
        } else if route == UiNavRoute.Playing {
            return false;
        } else if route == UiNavRoute.GameFinished {
            return false;
        } else if route == UiNavRoute.Fallback {
            return false;
        } else if route == UiNavRoute.ConnectionFailed {
            return false;
        } else if route == UiNavRoute.Connecting {
            return false;
        }
        return false;
    }

    VerticalLayout {
        if show-topbar(root.nav-route): topbar := TopBar {
            items: items(nav-route);
            show-backbutton: root.nav-route == UiNavRoute.NameInputFirst || root.nav-route == UiNavRoute.NameInputNonFirst || (root.nav-route == UiNavRoute.ModeSelect && !ModeSelectAdopter.busy && ModeSelectAdopter.back-enabled);
            current-item-idx: current-item-idx(nav-route);
            click-backbutton => {
                root.click-backbutton();
            }
        }

        if nav-route == UiNavRoute.Start: StartScreen { }
        if nav-route == UiNavRoute.NameInputFirst: NameInputFirstScreen { }
        if nav-route == UiNavRoute.DifficulitySelect:DifficulitySelectScreen { }
        if nav-route == UiNavRoute.Playing: PlayingScreen { }
        if nav-route == UiNavRoute.GameFinished: GameFinishedScreen { }
        if nav-route == UiNavRoute.Fallback: FallbackScreen { }
        if nav-route == UiNavRoute.ConnectionFailed: ConnectionFailedScreen { }
        if nav-route == UiNavRoute.Connecting: ConnectingScreen { }
        if nav-route == UiNavRoute.NameInputNonFirst: NameInputNonFirstScreen { }
        if nav-route == UiNavRoute.ModeSelect: ModeSelectScreen { }
        //@xtask-screen
    }
}

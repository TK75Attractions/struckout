    out property <brush> ref_primary_60: #00a1a2;
    out property <brush> ref_primary_70: #00bebf;
    out property <brush> ref_primary_80: #00dcdd;
    out property <brush> ref_primary_90: #00fbfc;
    out property <brush> ref_primary_95: #adffff;
    out property <brush> ref_primary_98: #e2fffe;
    out property <brush> ref_primary_99: #f1fffe;
    out property <brush> ref_primary_100: #ffffff;


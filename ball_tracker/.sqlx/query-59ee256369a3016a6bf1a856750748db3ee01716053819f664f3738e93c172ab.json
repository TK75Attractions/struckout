  "query": "\n            SELECT * FROM frames f1\n            WHERE EXISTS (\n                SELECT 1 FROM frames f2\n                WHERE f2.timestamp BETWEEN f1.timestamp - 5 AND f1.timestamp + 5\n                AND f2.session_id <> f1.session_id\n            )\n            ORDER BY timestamp\n        ",

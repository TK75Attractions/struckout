flowchart LR
    subgraph Touchpanel["タッチパネル"]
        Start["開始"]
        NewName["新規プレイヤー名"]
        ExistingName["登録済みプレイヤー名"]
        Mode["モード選択"]
        Difficulty["難易度選択・準備完了待ち"]
        Playing["プレイ中"]
        Finished["ゲーム終了"]

        Start -->|初回| NewName
        Start -->|2回目以降| ExistingName
        NewName --> Mode
        ExistingName --> Mode
        Mode --> Difficulty
        Difficulty -->|GameStarted| Playing
        Playing -->|GameFinished| Finished
        Finished -->|ホーム復帰を要求| Start
    end

    subgraph GameMaster["game-master"]
        AddPlayer(["AddPlayer"])
        GetPlayer(["GetPlayer"])
        StartSession(["StartSession"])
        SetGameMode(["SetGameMode"])
        SetSessionDifficulty(["SetSessionDifficulty"])
        SetSessionReady(["SetSessionReady"])
        DifficultyChanged{{"SessionDifficultyChanged"}}
        GameStarted{{"GameStarted"}}
        GameTimeAndScore{{"GameTimeLimitNotify / GameScoreChanged"}}
        GameFinished{{"GameFinished"}}
        GoHomeScreen(["GoHomeScreen"])
    end

    subgraph Projector["プロジェクター"]
        ProjectorWaiting["待機"]
        ProjectorPlaying["プレイ中"]
        ProjectorScore["結果表示"]
        ProjectorRanking["ランキング表示"]
        ProjectorHome["ホーム"]

        ProjectorWaiting -->|GameStarted| ProjectorPlaying
        ProjectorPlaying -->|GameFinished| ProjectorScore
        ProjectorScore -->|アニメーション終了の1秒後| ProjectorRanking
        ProjectorRanking -->|画面遷移通知| ProjectorHome
    end

    NewName --> AddPlayer
    ExistingName --> GetPlayer
    Mode --> StartSession
    Mode --> SetGameMode
    Difficulty --> SetSessionDifficulty
    SetSessionDifficulty -.-> DifficultyChanged
    DifficultyChanged -.-> Difficulty
    Difficulty --> SetSessionReady
    SetSessionReady -.->|単独: 1台 / 協力: 両台が準備完了| GameStarted
    GameStarted -.-> Playing
    GameStarted -.-> ProjectorPlaying
    GameTimeAndScore -.-> Playing
    GameTimeAndScore -.-> ProjectorPlaying
    GameFinished -.-> Finished
    GameFinished -.-> ProjectorScore
    Finished --> GoHomeScreen
    GoHomeScreen -.-> ProjectorHome

    style Touchpanel fill:#FFF7ED,stroke:#FB923C
    style GameMaster fill:#F8FAFC,stroke:#94A3B8
    style Projector fill:#F0FDFA,stroke:#2DD4BF

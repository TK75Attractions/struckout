<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StruckoutCameraApp">
        <!-- PC から adb で開き直したとき (scripts/camera-remote.ps1)、新しい画面を重ねず、いまの画面に届ける -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.StruckoutCameraApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PC から adb で設定や Save frame を行う。DUMP の権限は adb のシェルにしかないので、ほかのアプリからは送れない -->
        <receiver
            android:name=".remote.RemoteControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.taichi765.struckoutCameraApp.remote.SET_CONFIG" />
                <action android:name="com.taichi765.struckoutCameraApp.remote.SAVE_FRAME" />
                <action android:name="com.taichi765.struckoutCameraApp.remote.RETRY_CONNECTION" />
                <action android:name="com.taichi765.struckoutCameraApp.remote.STATUS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
# will have compiled files and executables
target/

# Repository-local development toolchains
.tools/

# Unity generated state
projector/[Ll]ibrary/
projector/[Tt]emp/
projector/[Oo]bj/
projector/[Ll]ogs/
projector/[Uu]ser[Ss]ettings/

# Android/Gradle generated state
struckoutCameraApp/.gradle/
struckoutCameraApp/**/build/

# .NET generated state
sandbox/testTcpCLI/bin/
sandbox/testTcpCLI/obj/

# Local-only debug tooling.
# tools/ は各自のローカルでだけ使うデバッグ用 GUI を置く場所。
# 通信層と protobuf は sandbox/testTcpCLI 配下のコミット済みファイルをリンク参照するので、
# ここを消してもリポジトリのビルドは壊れない。
tools/

# These are backup files generated by rustfmt
**/*.rs.bk

# Ignore .DS_Store file in mac
**/.DS_Store
